  "published": [
    {
      "source_id": "cdc-flood-reentry",
      "citation_id": "0a803dca33e55c0c5dea445f1db7f8bde62474553fc53314f8b933bf229b2ce8",
      "passage": "If your home has damage, do not reenter until it has been examined by a building inspector for safety."
    },
    {
      "source_id": "cdc-flood-reentry",
      "citation_id": "988c9fcd1da54e741fcd265c007f7388a9cfa52efc4b6c74d99796e1cb5a3fb1",
      "passage": "NEVER turn power on or off yourself or use an electric tool or appliance while standing in water."
    },
    {
      "source_id": "cdc-flood-reentry",
      "citation_id": "a60f54160bbb2ce43a813d4ad0a83e72e8212aec8492956a7dd56b4e89c532c7",
      "passage": "Tap water may not be safe to drink. Listen to local warnings."
    },
    {
      "source_id": "cdc-flood-reentry",
      "citation_id": "ab2bd10259fd31091cacb80da02f5e8e042eeef7fb9d88b6f37ff01d23622498",
      "passage": "When returning to a flooded home after a natural disaster, be aware that your house may be contaminated with mold or sewage, which can make you sick.\nTake steps to protect your health and safety when returning to your flooded home."
    },
    {
      "source_id": "cdc-flood-reentry",
      "citation_id": "ffa4fe9ae4c8f85d1030c5907c403b265370c503fefd6ab9f87e097ccf620465",
      "passage": "Have an electrician check the house's electrical system before turning the power on again."
    },
    {
      "source_id": "usagov-disaster-housing",
      "citation_id": "8630330fbd12aabc3c31bff38cd811d234bc3e214e05021a322d6f082d9f2b48",
      "passage": "After you register for disaster assistance with FEMA, you will find out if you qualify for transitional housing."
    }
  ],

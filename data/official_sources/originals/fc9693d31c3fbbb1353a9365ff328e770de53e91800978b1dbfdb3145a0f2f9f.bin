            <div class="field field--name-field-cta-banner-content field--type-entity-reference-revisions field--label-hidden field__item">

      

<div class="paragraph paragraph--type--cta-banner paragraph--view-mode--default paragraph--id--7976 padding-top-105 padding-bottom-1 tablet:padding-bottom-0 usa-dark-background bg-accent-warm-dark">
  <div class="grid-container">


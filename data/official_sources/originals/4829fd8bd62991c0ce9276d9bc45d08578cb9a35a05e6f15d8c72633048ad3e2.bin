      <related-faq>
         <name>Can I get assistance if I am not enrolled in the event of an emergency?</name>
         <showProductCollection></showProductCollection>
         <showLicenseCollection></showLicenseCollection>
         <organization></organization>
         <faq>
            <calltakerOnly></calltakerOnly>
            <keywords>Last-minute registrations, EEAP, Emergency Evacuation Assistance, EEAP </keywords>
            <priority></priority>
            <Jurisdiction_511>
               <jurisdiction>local</jurisdiction>
               <localType>county</localType>
               <county>miami-dade</county>
               <municipality></municipality>
               <organization>org1665164800368109</organization>
               <subOrganization></subOrganization>
               <parentService></parentService>
            </Jurisdiction_511>
            <text>Can I get assistance if I am not enrolled in the event of an emergency?</text>
            <displayTitle>Last-minute registration</displayTitle>
            <about>In the event of an emergency, eligible residents that have not registered to the EEAP
               should call 311.</about>
            <answer>&lt;p&gt;When an emergency arises, pre-registered residents will have priority over those
               who have not registered for the program.&lt;/p&gt;
               &lt;p&gt;Residents not currently enrolled in the EEAP, who need emergency and evacuation
               assistance, should call 311 to request assistance. Contacting the 311 Contact Center
               does not guarantee that a resident will receive assistance in the event of an emergency
               or are enrolled in the EEAP. Residents who have not pre-registered with the EEAP are
               encouraged to seek alternate transportation and sheltering arrangements with family
               and friends.&lt;/p&gt;</answer>
            <publishDate>2022-10-07</publishDate>
            <pubHour>06</pubHour>
            <pubMin>55</pubMin>
            <pubTod>pm</pubTod>
            <call311></call311>
            <call711></call711>
            <category>
